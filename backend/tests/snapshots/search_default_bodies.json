   "sql": "SELECT te.text_id, te.juan_num, te.chunk_text, 1 - (te.embedding <=> $1::vector) AS score, COALESCE(bt.title_zh, '') AS title_zh, bt.translator, bt.dynasty, bt.category, ds.code AS source_code, bt.cbeta_id, bt.cbeta_url, CASE WHEN bt.content_char_count > 0 THEN true ELSE false END AS has_content FROM text_embeddings te JOIN buddhist_texts bt ON bt.id = te.text_id LEFT JOIN data_sources ds ON ds.id = bt.source_id WHERE te.embedding IS NOT NULL AND 1 - (te.embedding <=> $1::vector) >= $2  ORDER BY te.embedding <=> $1::vector LIMIT $3"
  },
