{
  "_doc": "「佛真的说过吗」核对页的留出集：2026-10-11 在调出处排序之前写定，调参期间不看它的成绩。accept=可接受的首位出处（同经异译 / 同书异本并列）；class=期望的藏经分类。发现集（discovery.json，调参时可以看）是首轮基率测量用过的 25 句。",
  "items": [
    {"q": "知一切法无我，得成于忍", "accept": ["T0235"], "class": "sutra"},
    {"q": "如来说一切诸相，即是非相", "accept": ["T0235"], "class": "sutra"},
    {"q": "观自在菩萨，行深般若波罗蜜多时", "accept": ["T0251"], "class": "sutra"},
    {"q": "心无挂碍，无挂碍故，无有恐怖", "accept": ["T0251"], "class": "sutra"},
    {"q": "执持名号，若一日，若二日", "accept": ["T0366"], "class": "sutra"},
    {"q": "其土众生，无有众苦，但受诸乐，故名极乐", "accept": ["T0366"], "class": "sutra"},
    {"q": "诸佛世尊唯以一大事因缘故出现于世", "accept": ["T0262"], "class": "sutra"},
    {"q": "三界无安，犹如火宅", "accept": ["T0262"], "class": "sutra"},
    {"q": "心如工画师，能画诸世间", "accept": ["T0278", "T0279"], "class": "sutra"},
    {"q": "菩萨清凉月，常游毕竟空", "accept": ["T0278", "T0279"], "class": "sutra"},
    {"q": "譬如暗中宝，无灯不可见", "accept": ["T0278", "T0279"], "class": "sutra"},
    {"q": "当自炽燃，炽燃于法，勿他炽燃", "accept": ["T0001"], "class": "sutra"},
    {"q": "何期自性，本自清净", "accept": ["T2007", "T2008"], "class": "school"},
    {"q": "佛法在世间，不离世间觉", "accept": ["T2007", "T2008"], "class": "school"},
    {"q": "迷时师度，悟了自度", "accept": ["T2007", "T2008"], "class": "school"},
    {"q": "一切业障海，皆从妄想生", "accept": ["T0277"], "class": "sutra"},
    {"q": "犹如莲花不著水，亦如日月不住空", "accept": ["T0293"], "class": "sutra"},
    {"q": "虚空界尽，众生界尽，众生业尽，众生烦恼尽，我礼乃尽", "accept": ["T0293"], "class": "sutra"},
    {"q": "是心作佛，是心是佛", "accept": ["T0365"], "class": "sutra"},
    {"q": "知幻即离，不作方便；离幻即觉，亦无渐次", "accept": ["T0842"], "class": "sutra"}
  ]
