[
 {
  "text": "應無所住而生其心",
  "title_zh": "金剛般若波羅蜜經",
  "cbeta_id": "T0235",
  "text_id": 7,
  "juan_num": 1,
  "reader_path": "/texts/7/read?juan=1&anchor=p0749c22&hl=1949-1957"
 },
 {
  "text": "諸法從本來，常自寂滅相",
  "title_zh": "妙法蓮華經",
  "cbeta_id": "T0262",
  "text_id": 6513,
  "juan_num": 1,
  "reader_path": "/texts/6513/read?juan=1&anchor=p0008b25&hl=9642-9652"
 },
 {
  "text": "心如工畫師，能畫諸世間",
  "title_zh": "大方廣佛華嚴經",
  "cbeta_id": "T0279",
  "text_id": 12,
  "juan_num": 19,
  "reader_path": "/texts/12/read?juan=19&anchor=p0102a21&hl=3899-3909"
 },
 {
  "text": "隨其心淨，則佛土淨",
  "title_zh": "維摩詰所說經",
  "cbeta_id": "T0475",
  "text_id": 28,
  "juan_num": 1,
  "reader_path": "/texts/28/read?juan=1&anchor=p0538c05&hl=2868-2876"
 },
 {
  "text": "此有故彼有，此起故彼起",
  "title_zh": "雜阿含經",
  "cbeta_id": "T0099",
  "text_id": 3,
  "juan_num": 12,
  "reader_path": "/texts/3/read?juan=12&anchor=p0086a29&hl=13435-13447"
 },
 {
  "text": "眾因緣生法，我說即是無，亦為是假名，亦是中道義",
  "title_zh": "中論",
  "cbeta_id": "T1564",
  "text_id": 40,
  "juan_num": 4,
  "reader_path": "/texts/40/read?juan=4&anchor=p0033b11&hl=5309-5332"
 },
 {
  "text": "菩提本無樹，明鏡亦非臺",
  "title_zh": "六祖大師法寶壇經",
  "cbeta_id": "T2008",
  "text_id": 58,
  "juan_num": 1,
  "reader_path": "/texts/58/read?juan=1"
 },
 {
  "text": "諸惡莫作，諸善奉行，自淨其意，是諸佛教",
  "title_zh": "增壹阿含經",
  "cbeta_id": "T0125",
  "text_id": 4,
  "juan_num": 1,
  "reader_path": "/texts/4/read?juan=1&anchor=p0551a13&hl=2607-2626"
 },
 {
  "text": "知見立知，即無明本；知見無見，斯即涅槃",
  "title_zh": "大佛頂如來密因修證了義諸菩薩萬行首楞嚴經",
  "cbeta_id": "T0945",
  "text_id": 65,
  "juan_num": 5,
  "reader_path": "/texts/65/read?juan=5&anchor=p0124c09&hl=531-547"
 },
 {
  "text": "一切眾生悉有佛性",
  "title_zh": "大般涅槃經",
  "cbeta_id": "T0374",
  "text_id": 15,
  "juan_num": 6,
  "reader_path": "/texts/15/read?juan=6"
 },
 {
  "text": "佛法大海，信為能入，智為能度",
  "title_zh": "大智度論",
  "cbeta_id": "T1509",
  "text_id": 39,
  "juan_num": 1,
  "reader_path": "/texts/39/read?juan=1&anchor=p0063a01&hl=8264-8278"
 },
 {
  "text": "知足之人，雖臥地上，猶為安樂",
  "title_zh": "佛垂般涅槃略說教誡經",
  "cbeta_id": "T0389",
  "text_id": 21,
  "juan_num": 1,
  "reader_path": "/texts/21/read?juan=1&anchor=p1111c06&hl=1572-1585"
 },
 {
  "text": "色不異空，空不異色；色即是空，空即是色",
  "title_zh": "般若波羅蜜多心經",
  "cbeta_id": "T0251",
  "text_id": 9,
  "juan_num": 1,
  "reader_path": "/texts/9/read?juan=1"
 },
 {
  "text": "初發心時，便成正覺",
  "title_zh": "大方廣佛華嚴經",
  "cbeta_id": "T0278",
  "text_id": 11,
  "juan_num": 8,
  "reader_path": "/texts/11/read?juan=8&anchor=p0449c14&hl=9760-9768"
 },
 {
  "text": "不可以少善根福德因緣，得生彼國",
  "title_zh": "佛說阿彌陀經",
  "cbeta_id": "T0366",
  "text_id": 20,
  "juan_num": 1,
  "reader_path": "/texts/20/read?juan=1&anchor=p0347b09&hl=1134-1148"
 },
 {
  "text": "世間無常，國土危脆",
  "title_zh": "佛說八大人覺經",
  "cbeta_id": "T0779",
  "text_id": 7007,
  "juan_num": 1,
  "reader_path": "/texts/7007/read?juan=1&anchor=p0715b07&hl=48-56"
 },
 {
  "text": "不可怨以怨，終已得休息；行忍得息怨，此名如來法",
  "title_zh": "出曜經",
  "cbeta_id": "T0212",
  "text_id": 6469,
  "juan_num": 16,
  "reader_path": "/texts/6469/read?juan=16&anchor=p0697a04&hl=6101-6124"
 },
 {
  "text": "由假說我法，有種種相轉，彼依識所變，此能變唯三",
  "title_zh": "唯識三十論頌",
  "cbeta_id": "T1586",
  "text_id": 45,
  "juan_num": 1,
  "reader_path": "/texts/45/read?juan=1"
 },
 {
  "text": "知幻即離，不作方便；離幻即覺，亦無漸次",
  "title_zh": "大方廣圓覺修多羅了義經",
  "cbeta_id": "T0842",
  "text_id": 64,
  "juan_num": 1,
  "reader_path": "/texts/64/read?juan=1&anchor=p0914a20&hl=1585-1604"
 },
 {
  "text": "凡所有相，皆是虛妄。若見諸相非相，則見如來",
  "title_zh": "金剛般若波羅蜜經",
  "cbeta_id": "T0235",
  "text_id": 7,
  "juan_num": 1,
  "reader_path": "/texts/7/read?juan=1&anchor=p0749a24&hl=732-753"
 },
 {
  "text": "唯有一乘法，無二亦無三",
  "title_zh": "妙法蓮華經",
  "cbeta_id": "T0262",
  "text_id": 6513,
  "juan_num": 1,
  "reader_path": "/texts/6513/read?juan=1&anchor=p0008a17&hl=9167-9178"
 },
 {
  "text": "若人欲了知，三世一切佛，應觀法界性，一切唯心造",
  "title_zh": "大方廣佛華嚴經",
  "cbeta_id": "T0279",
  "text_id": 12,
  "juan_num": 19,
  "reader_path": "/texts/12/read?juan=19&anchor=p0102a29&hl=4003-4026"
 },
 {
  "text": "以一切眾生病，是故我病",
  "title_zh": "維摩詰所說經",
  "cbeta_id": "T0475",
  "text_id": 28,
  "juan_num": 2,
  "reader_path": "/texts/28/read?juan=2&anchor=p0544b21&hl=512-522"
 },
 {
  "text": "心惱故眾生惱，心淨故眾生淨",
  "title_zh": "雜阿含經",
  "cbeta_id": "T0099",
  "text_id": 3,
  "juan_num": 10,
  "reader_path": "/texts/3/read?juan=10&anchor=p0069c12&hl=10004-10017"
 },
 {
  "text": "諸法不自生，亦不從他生，不共不無因，是故知無生",
  "title_zh": "中論",
  "cbeta_id": "T1564",
  "text_id": 40,
  "juan_num": 1,
  "reader_path": "/texts/40/read?juan=1&anchor=p0002b06&hl=1515-1538"
 },
 {
  "text": "佛法在世間，不離世間覺",
  "title_zh": "六祖大師法寶壇經",
  "cbeta_id": "T2008",
  "text_id": 58,
  "juan_num": 1,
  "reader_path": "/texts/58/read?juan=1&anchor=p0351c09&hl=7130-7140"
 },
 {
  "text": "心為法本，心尊心使",
  "title_zh": "增壹阿含經",
  "cbeta_id": "T0125",
  "text_id": 4,
  "juan_num": 51,
  "reader_path": "/texts/4/read?juan=51&anchor=p0827b13&hl=3114-3122"
 },
 {
  "text": "淨極光通達，寂照含虛空",
  "title_zh": "大佛頂如來密因修證了義諸菩薩萬行首楞嚴經",
  "cbeta_id": "T0945",
  "text_id": 65,
  "juan_num": 6,
  "reader_path": "/texts/65/read?juan=6&anchor=p0131a23&hl=4255-4266"
 },
 {
  "text": "依法不依人，依義不依語，依智不依識",
  "title_zh": "大般涅槃經",
  "cbeta_id": "T0374",
  "text_id": 15,
  "juan_num": 6,
  "reader_path": "/texts/15/read?juan=6&anchor=p0401b28&hl=8562-8578"
 },
 {
  "text": "慈悲是佛道之根本",
  "title_zh": "大智度論",
  "cbeta_id": "T1509",
  "text_id": 39,
  "juan_num": 27,
  "reader_path": "/texts/39/read?juan=27&anchor=p0256c16&hl=744-751"
 },
 {
  "text": "汝等比丘，若欲脫諸苦惱，當觀知足",
  "title_zh": "佛垂般涅槃略說教誡經",
  "cbeta_id": "T0389",
  "text_id": 21,
  "juan_num": 1,
  "reader_path": "/texts/21/read?juan=1&anchor=p1111c05&hl=1541-1556"
 },
 {
  "text": "心無罣礙，無罣礙故，無有恐怖，遠離顛倒夢想",
  "title_zh": "般若波羅蜜多心經",
  "cbeta_id": "T0251",
  "text_id": 9,
  "juan_num": 1,
  "reader_path": "/texts/9/read?juan=1&anchor=p0848c14&hl=235-256"
 },
 {
  "text": "一切有為法，如夢幻泡影，如露亦如電，應作如是觀",
  "title_zh": "金剛般若波羅蜜經",
  "cbeta_id": "T0235",
  "text_id": 7,
  "juan_num": 1,
  "reader_path": "/texts/7/read?juan=1&anchor=p0752b28&hl=6931-6957"
 },
 {
  "text": "我深敬汝等，不敢輕慢",
  "title_zh": "妙法蓮華經",
  "cbeta_id": "T0262",
  "text_id": 6513,
  "juan_num": 6,
  "reader_path": "/texts/6513/read?juan=6&anchor=p0050c19&hl=6337-6346"
 },
 {
  "text": "信為道元功德母，長養一切諸善法",
  "title_zh": "大方廣佛華嚴經",
  "cbeta_id": "T0279",
  "text_id": 12,
  "juan_num": 14,
  "reader_path": "/texts/12/read?juan=14&anchor=p0072b18&hl=4397-4411"
 },
 {
  "text": "不斷煩惱而入涅槃",
  "title_zh": "維摩詰所說經",
  "cbeta_id": "T0475",
  "text_id": 28,
  "juan_num": 1,
  "reader_path": "/texts/28/read?juan=1&anchor=p0539c25&hl=5063-5070"
 },
 {
  "text": "當觀色無常，如是觀者，則為正觀",
  "title_zh": "雜阿含經",
  "cbeta_id": "T0099",
  "text_id": 3,
  "juan_num": 1,
  "reader_path": "/texts/3/read?juan=1&anchor=p0001a07&hl=61-76"
 },
 {
  "text": "不生亦不滅，不常亦不斷，不一亦不異，不來亦不出",
  "title_zh": "中論",
  "cbeta_id": "T1564",
  "text_id": 40,
  "juan_num": 1,
  "reader_path": "/texts/40/read?juan=1&anchor=p0001b14&hl=36-59"
 },
 {
  "text": "何期自性，本自清淨",
  "title_zh": "六祖大師法寶壇經",
  "cbeta_id": "T2008",
  "text_id": 58,
  "juan_num": 1,
  "reader_path": "/texts/58/read?juan=1&anchor=p0349a19&hl=2558-2566"
 },
 {
  "text": "過去心不可得，現在心不可得，未來心不可得",
  "title_zh": "金剛般若波羅蜜經",
  "cbeta_id": "T0235",
  "text_id": 7,
  "juan_num": 1,
  "reader_path": "/texts/7/read?juan=1&anchor=p0751b27&hl=5144-5164"
 },
 {
  "text": "知我說法，如筏喻者，法尚應捨，何況非法",
  "title_zh": "金剛般若波羅蜜經",
  "cbeta_id": "T0235",
  "text_id": 7,
  "juan_num": 1,
  "reader_path": "/texts/7/read?juan=1&anchor=p0749b10&hl=1052-1071"
 },
 {
  "text": "若以色見我，以音聲求我，是人行邪道，不能見如來",
  "title_zh": "金剛般若波羅蜜經",
  "cbeta_id": "T0235",
  "text_id": 7,
  "juan_num": 1,
  "reader_path": "/texts/7/read?juan=1&anchor=p0752a17&hl=6109-6132"
 },
 {
  "text": "一切法無我，得成於忍",
  "title_zh": "金剛般若波羅蜜經",
  "cbeta_id": "T0235",
  "text_id": 7,
  "juan_num": 1,
  "reader_path": "/texts/7/read?juan=1&anchor=p0752a26&hl=6299-6309"
 }
]
